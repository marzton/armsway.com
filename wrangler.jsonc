{
  "name": "armsway-com",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ENV": "production",
    "CONTACT_TO_EMAIL": "rob@armsway.com",
    "ACCESS_MODE": "selective"
  },
  "kv_namespaces": [
    {
      "binding": "CACHE_KV",
      "id": "ef85567a77364f87809047ac1aff950c"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "AUDIT_DB",
      "database_name": "gs_audit_db",
      "database_id": "1ae71d76-188f-481b-91d9-db2d39013f68",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    {
      "pattern": "armsway.com",
      "custom_domain": true
    },
    {
      "pattern": "www.armsway.com",
      "custom_domain": true
    }
  ],
  "keep_vars": true
}
